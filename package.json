{
  "name": "life-director",
  "productName": "Director",
  "version": "0.5.2",
  "private": true,
  "description": "Local-first personal director for work, life and solo game development.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release:win": "npm run build && electron-builder --win nsis --publish always --config build/electron-builder.publish.yml",
    "release:dry": "npm run build && electron-builder --win nsis --publish never --config build/electron-builder.publish.yml"
  },
  "dependencies": {
    "openai": "^7.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.egor.director",
    "productName": "Director",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Director"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Egor / Director",
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  }
}
